# BrandProof Configuration
# Copy this file to .env and configure as needed.

# Database file path (defaults to brandproof.db in root)
BRANDPROOF_DB_PATH=brandproof.db

# Workspace Branding
BRANDPROOF_WORKSPACE_NAME="Acrobatics Health & Tech"
BRANDPROOF_DEFAULT_BRAND="Acrobatics"

# Optional External AI Assistant
# If left empty, BrandProof operates in transparent rule-based verification mode with 100% deterministic accuracy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=none
